# 服务端口
PORT=8000
HOST=0.0.0.0

# 客户端调用时的 API 认证密钥 (留空或设置为 any 则不验证)
API_KEY=sk-doubao-proxy-123456

# 浏览器相关设置
# HEADLESS: true 为无头后台运行；首次扫码或调试可设为 false 显示浏览器界面
HEADLESS=true
# 浏览器使用 Chrome 还是 Edge: 'chrome' 或 'msedge'
BROWSER_CHANNEL=chrome
# 浏览器用户数据持久化目录（保存登录状态、Cookie，避免重启后重新登录）
USER_DATA_DIR=./.doubao_user_data

# 默认模型
DEFAULT_MODEL=doubao-pro
